        "/api/compromisos": {
            "get": {
                "tags": [
                    "Compromisos"
                ],
                "summary": "Listar compromisos",
                "operationId": "8c306e7a673bc93567a578aa2f2e659b",
                "parameters": [
                    {
                        "name": "periodo",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "default": "actual",
                            "enum": [
                                "actual",
                                "proximos",
                                "todos"
                            ]
                        }
                    },
                    {
                        "name": "estado",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "pendiente",
                                "parcial",
                                "vencido",
                                "antiguo",
                                "pagado",
                                "cancelado"
                            ]
                        }
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista paginada"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Compromisos"
                ],
                "summary": "Crear compromiso",
                "description": "recurrencia_tipo=recurrente crea una serie (frecuencia, dia_pago, dia_pago_2, dia_semana, fecha_inicio, finalizacion, fecha_fin, total_cuotas). dia_pago=31 significa \"último día del mes\".",
                "operationId": "a593266b6fcff2f71fb88edabc892cf9",
                "responses": {
                    "201": {
                        "description": "Creado: el compromiso o, si es recurrente, su primer pago (o null si aún no corresponde)"
                    },
                    "422": {
                        "description": "Error de validación"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
