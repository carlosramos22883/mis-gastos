        "/api/efectivo": {
            "get": {
                "tags": [
                    "Efectivo"
                ],
                "summary": "Movimientos de un ciclo con su resumen",
                "description": "Sin \"ciclo\" devuelve el ciclo actual. \"ciclo\" acepta cualquier fecha (Y-m-d) dentro del ciclo deseado.",
                "operationId": "1cca93ecc12e37452223a85029a4bb7d",
                "parameters": [
                    {
                        "name": "ciclo",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    },
                    {
                        "name": "tipo",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "ingreso",
                                "egreso"
                            ]
                        }
                    },
                    {
                        "name": "categoria",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 20
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "data + ciclo + resumen + meta de paginación"
                    },
                    "404": {
                        "description": "Ciclo futuro o inválido"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Efectivo"
                ],
                "summary": "Registrar ingreso o egreso",
                "description": "Con \"compromiso_id\" el egreso se aplica como pago (total o parcial) de ese compromiso.",
                "operationId": "0f4d7b33dbec37a54c240757a6145ace",
                "responses": {
                    "201": {
                        "description": "Registrado"
                    },
                    "422": {
                        "description": "Validación (ej. el egreso supera el saldo)"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
